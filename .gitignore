.idea/
.vscode/
.DS_Store
Thumbs.db
*.swp
*.swo
*~
*.tmp
*.temp
*.bak
tmp/
temp/

# Curated, immutable reproduction snapshots (all other generated data/runs
# remain ignored by the broad rules above).
!data/
data/*
!data/candidates.jsonl
!data/filter_results.jsonl
!data/pool.jsonl
!data/pool.jsonl.stats.json
!data/bench/
data/bench/*
