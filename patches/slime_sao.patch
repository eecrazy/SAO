+        # paper_006_sao: verify the frozen-attention critic freeze actually took.
+        # Qwen3.5 is hybrid (24 linear-attn + 8 full-attn of 32 layers); slime
+        # nests BOTH mixer types under the `self_attention` submodule, so the
+        # "self_attention" pattern must freeze all token-mixers (both types) while
+        # leaving MLP/embeddings/value-head trainable. A frozen fraction near 0%
+        # or 100% signals a naming mismatch (method fidelity bug). Logs a few
+        # example frozen names for an eyeball check.
+        frozen = sum(p.numel() for p in model.parameters() if not p.requires_grad)
+        trainable = sum(p.numel() for p in model.parameters() if p.requires_grad)
+        examples = [n for n, p in model.named_parameters() if not p.requires_grad][:4]
+        logging.getLogger(__name__).info(
+            "SAO_FREEZE patterns=%s frozen=%d trainable=%d (%.1f%% frozen); e.g. %s",
+            args.freeze_params_name_list, frozen, trainable,
+            100 * frozen / max(frozen + trainable, 1), examples,
+        )
diff --git a/slime/rollout/sglang_rollout.py b/slime/rollout/sglang_rollout.py
index 9dcf5fce..47081989 100644
--- a/slime/rollout/sglang_rollout.py
+++ b/slime/rollout/sglang_rollout.py
@@ -164,6 +164,19 @@ async def generate(args: Namespace, sample: Sample, sampling_params: dict[str, A
 
     prompt_ids = _prepare_prompt_ids(sample, state.tokenizer, state.processor)
 
+    # paper_006 (D-len): enforce a HARD *total* response-length cap. Fully-async
+    # aborts in-flight generations on weight updates and requeues them; the
+    # continuation re-dispatches with the GLOBAL sampling_params (full
+    # max_new_tokens), so a trajectory spanning K weight-versions accumulates up to
+    # K× rollout_max_response_len (observed 24k→36k and climbing → actor OOM on the
+    # 36k microbatch). Cap the continuation budget by tokens already generated so
+    # the total never exceeds the configured cap; when exhausted → TRUNCATED below.
+    sampling_params = dict(sampling_params)
+    sampling_params["max_new_tokens"] = min(
+        sampling_params["max_new_tokens"],
+        max(0, args.rollout_max_response_len - sample.response_length),
+    )
+
     assert (
         sampling_params["max_new_tokens"] >= 0
     ), f"max_new_tokens: {sampling_params['max_new_tokens']} should not be less than 0"
